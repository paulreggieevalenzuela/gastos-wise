# PostgreSQL connection string from your Neon project (dawn-poetry-54427459).
# Neon dashboard -> Connect -> "Pooled connection" for DATABASE_URL, and
# toggle "Connection pooling" off for the "Direct connection" -> DIRECT_URL
# (the pooled one for the app at runtime, the direct one to run migrations).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Random 32+ byte secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Base URL used to build links inside emails (confirmation, password reset).
# Set this to your real deployed URL in production.
APP_URL="http://localhost:3000"

# Email delivery (registration confirmation + forgot-password), via Resend's
# API (see README "Email"). Leave RESEND_API_KEY unset during local dev —
# emails are logged to the server console instead of sent, including the
# confirm/reset link, so the flows still work end-to-end without an account.
RESEND_API_KEY=""
EMAIL_FROM="Ledger <onboarding@resend.dev>"

# The seeded convenience dev login (see README "Authentication"). Skips
# email confirmation — it's marked verified automatically on seed.
MOCK_USER_USERNAME="paulreggie05"
MOCK_USER_EMAIL="paulreggie05@example.com"
MOCK_USER_PASSWORD="123456789"
MOCK_USER_NAME="Paul"
